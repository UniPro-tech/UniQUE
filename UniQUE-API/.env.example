# Docker Compose local development settings.
ENV=development
GIN_MODE=debug
DB_DSN=root:Rootpassword@tcp(db:3306)/devdb?charset=utf8mb4&parseTime=True&loc=Local
CONFIG_APP_NAME=UniQUE
CONFIG_FRONTEND_URL=http://localhost:3000
CONFIG_ISSUER_URL=http://localhost:8000
CONFIG_ISSUER_INTERNAL_URL=http://auth:8080
CONFIG_EMAIL_SENDER_URL=http://mailserver:8080

# Replace these before testing Discord integration.
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_MEMBER_ROLE_ID=your-discord-member-role-id
DISCORD_MEMBER_APPLICATION_CHANNEL_ID=your-member-application-channel-id
