# Docker Compose local development settings.
ENV=development
GIN_MODE=debug
CONFIG_APP_NAME=UniQUE
CONFIG_FRONTEND_URL=http://localhost:3000
CONFIG_ISSUER_URL=http://auth:8080

# Replace these with a test SMTP server before sending mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=example-user
SMTP_PASSWORD=replace-me
SMTP_FROM=noreply@example.com
SMTP_SECURE=false
FROM_NAME=UniQUE Dev
COPYRIGHT_NAME=All-Japan Digital Creative Club UniProject
