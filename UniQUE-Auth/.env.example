# Docker Compose local development settings.
ENV=development
GIN_MODE=debug
DB_DSN=root:Rootpassword@tcp(db:3306)/devdb?charset=utf8mb4&parseTime=True&loc=Local
CONFIG_APP_NAME=UniQUE
CONFIG_FRONTEND_URL=http://localhost:3000
CONFIG_ISSUER_URL=http://localhost:8000
CONFIG_MAIL_SERVER_URL=http://mailserver:8080
CONFIG_KEY_TYPE=RSA
CONFIG_KEY_PUBLIC_PATH=/app/keys/public
CONFIG_KEY_PRIVATE_PATH=/app/keys/private
CONFIG_WEBAUTHN_RPID=localhost
CONFIG_WEBAUTHN_RP_DISPLAY_NAME=UniQUE Dev
CONFIG_WEBAUTHN_ORIGIN=http://localhost:3000
CONFIG_WEBAUTHN_DEBUG=true
