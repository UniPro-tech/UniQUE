# Bun local development settings. API and Auth run through Docker Compose.
AUTH_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8000
RESOURCE_API_URL=http://localhost:8001
NEXT_PUBLIC_RESOURCE_API_URL=http://localhost:8001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/oauth/discord/callback
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_MEMBER_ROLE_ID=your-discord-member-role-id

# Set this to a GAS Web App URL or a compatible local mock to test migration.
GAS_MIGRATE_API_URL=
NODE_ENV=development
