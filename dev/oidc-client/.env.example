# Browser-facing issuer URL. This must match the Auth server's configured issuer.
OIDC_ISSUER=http://localhost:8000
# Container-internal issuer URL used only for token and JWKS requests.
OIDC_ISSUER_INTERNAL=http://auth:8080
OIDC_CLIENT_ID=01J00000000000000000000001
OIDC_REDIRECT_URI=http://localhost:3002/callback
PORT=3002
